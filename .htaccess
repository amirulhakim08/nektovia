# NEKTOVIA — tetapan Apache (Hostinger)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Paksa HTTPS dan buang "www."
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://nektovia.com%{REQUEST_URI} [L,R=301]
  # Sekat fail tersembunyi (.git, .env, dll.)
  RewriteRule (^|/)\. - [F]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|png|jpg|svg|mp3|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<FilesMatch "^(README\.md|\.gitignore|CNAME)$">
  Require all denied
</FilesMatch>
